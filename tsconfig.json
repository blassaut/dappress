{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["cypress", "node"],
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "conformance/*.ts", "conformance/cypress/**/*.ts"]
}
