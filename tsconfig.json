{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "es2020",
      "dom"
    ],
    "types": [
      "cypress",
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "types",
    "conformance/*.ts",
    "conformance/cypress/**/*.ts"
  ]
}
