{
  "name": "dappress",
  "version": "0.3.0",
  "description": "MetaMask automation for Cypress: load the real extension, import a test wallet, answer dapp requests with cy.* commands. Tracks the latest MetaMask release.",
  "license": "MIT",
  "author": "Benjamin Lassaut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blassaut/dappress.git"
  },
  "homepage": "https://github.com/blassaut/dappress#readme",
  "bugs": {
    "url": "https://github.com/blassaut/dappress/issues"
  },
  "keywords": [
    "cypress",
    "metamask",
    "web3",
    "e2e",
    "testing",
    "wallet",
    "dapp"
  ],
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./support": {
      "types": "./types/support.d.ts",
      "default": "./src/support.js"
    }
  },
  "typesVersions": {
    "*": {
      "support": [
        "types/support.d.ts"
      ]
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "conformance": "node scripts/conformance.js",
    "check-types": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "cypress": ">=13.6.0"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "extract-zip": "^2.0.1",
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "cypress": "^16.1.1",
    "typescript": "^5.6.0"
  }
}
