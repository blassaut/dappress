{
  "name": "dappress",
  "version": "0.7.1",
  "description": "Test your dapp against the wallets your users run, starting with MetaMask: the real extension in Cypress, a test wallet, cy.* commands to answer its requests, checked against each MetaMask release. Wallet profiles of MetaMask, Rabby and Phantom.",
  "license": "MIT",
  "author": "Benjamin Lassaut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blassaut/dappress.git"
  },
  "homepage": "https://github.com/blassaut/dappress#readme",
  "bugs": {
    "url": "https://github.com/blassaut/dappress/issues"
  },
  "keywords": [
    "cypress",
    "cypress-plugin",
    "metamask",
    "rabby",
    "phantom",
    "wallet",
    "ethereum",
    "eip-1193",
    "web3",
    "dapp",
    "e2e",
    "testing"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "default": "./dist/support.js"
    }
  },
  "typesVersions": {
    "*": {
      "support": [
        "dist/support.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "conformance": "tsx scripts/conformance.ts",
    "matrix": "tsx scripts/matrix.ts",
    "profile": "tsx scripts/profile.ts",
    "test": "tsx --test src/*.test.ts scripts/*.test.ts conformance/*.test.ts",
    "check-types": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run check-types && npm test"
  },
  "peerDependencies": {
    "cypress": ">=15.10.0"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "extract-zip": "^2.0.1",
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  }
}
